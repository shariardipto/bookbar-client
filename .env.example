# Public URLs only; update together when the app origin changes.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Authentication requires Mongo settings and a high-entropy auth secret (32+ characters).
# Never prefix these secrets with NEXT_PUBLIC_.
BETTER_AUTH_SECRET=
MONGODB_URI=
MONGODB_DB_NAME=bookbar
# Google Web client: origin http://localhost:3000
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IMGBB_API_KEY=
